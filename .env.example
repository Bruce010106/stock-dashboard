# Tushare Pro 服务端 Token（可选）。留空时：
# - 今日选股自动使用腾讯历史日线降级；
# - 策略回测自动使用新浪财经免费数据源（无需任何密钥），5 分钟近似口径，
#   单次区间最长 30 个自然日，市值/换手率/量比为静态估算值。
# 配置该 Token（并开通 daily、daily_basic 和 stk_mins 权限）后，策略回测升级为
# 1 分钟点时精确口径，单次区间最长 90 个自然日。
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro

# 生产站点的完整地址，仅用于页面元数据。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 登录与云端组合数据。Publishable Key 可用于浏览器，Secret Key 不得提交或公开。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

